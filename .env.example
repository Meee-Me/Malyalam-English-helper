# Only needed to run the site on your own computer. On Vercel, add these in
# Project -> Settings -> Environment Variables instead.
# Copy this file to ".env" (same folder) and paste your keys after the = signs.
# The .env file is listed in .gitignore, so it is never uploaded to GitHub.

# Gemini key from https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=

# Sarvam key from https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Recommended: a password the family types once.
APP_PASSWORD=

# Optional settings
# GEMINI_MODEL=gemini-3.8-flash
# SARVAM_SPEAKER=
# SARVAM_PACE=0.9
# PORT=3000
