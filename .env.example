# Copy this file to ".env" (same folder) and paste your keys after the = signs.
# The .env file stays on your computer: it is listed in .gitignore, so it is
# never uploaded to GitHub. Never put keys inside the public/ folder.

# ChatGPT key from https://platform.openai.com/api-keys (starts with sk-)
OPENAI_API_KEY=

# Sarvam key from https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Recommended before putting the site online: a password the family types once.
APP_PASSWORD=

# Optional settings
# OPENAI_MODEL=gpt-5.5
# SARVAM_SPEAKER=
# SARVAM_PACE=0.9
# PORT=3000
